#: localesetup:22
#, sh-format
msgid "USAGE: localesetup [locale]"
msgstr "PENGGUNAAN: localesetup [locale]"

#: localesetup:23
#, sh-format
msgid "EXAMPLE: localesetup en_US"
msgstr "CONTOH: localesetup en_US"

#: localesetup:28
#, sh-format
msgid "ERROR: Too many arguments"
msgstr "KESALAHAN: Terlalu banyak argumen"

#: localesetup:34
#, sh-format
msgid "You need root privileges to run this"
msgstr "Anda memerlukan hak akses root untuk menjalankan ini"

#: localesetup:42
#, sh-format
msgid "Setting locale to $locale"
msgstr "Mengatur locale ke $locale"

#: localesetup:44
#, sh-format
msgid "ERROR: $newlocale is not a valid locale"
msgstr "KESALAHAN: $newlocale bukan locale yang valid"

#: localesetup:69
#, sh-format
msgid "System language configuration"
msgstr "Konfigurasi bahasa sistem"

#: localesetup:71
#, sh-format
msgid "OK"
msgstr "OK"

#: localesetup:72
#, sh-format
msgid "Exit"
msgstr "Keluar"

#: localesetup:74
#, sh-format
msgid "The current locale is $currentlocale."
msgstr "Locale saat ini adalah $currentlocale."

#: localesetup:75
#, sh-format
msgid "Please select your preferred system language:"
msgstr "Silakan pilih bahasa sistem pilihan Anda:"
