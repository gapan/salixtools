#: service:25
#, sh-format
msgid "This action requires root privileges."
msgstr "Tindakan ini memerlukan hak akses root."

#: service:46
#, sh-format
msgid ""
"${BOLDCYAN}Starting${COLOR_RESET} the "
"${BOLDWHITE}${servicename}${COLOR_RESET} service"
msgstr "${BOLDCYAN}Memulai${COLOR_RESET} layanan ${BOLDWHITE}${servicename}${COLOR_RESET}"

#: service:50 service:62 service:80
#, sh-format
msgid "No ${BOLDWHITE}${servicename}${COLOR_RESET} service"
msgstr "Tidak ada layanan ${BOLDWHITE}${servicename}${COLOR_RESET}"

#: service:56
#, sh-format
msgid ""
"${BOLDYELLOW}Stopping${COLOR_RESET} the "
"${BOLDWHITE}${servicename}${COLOR_RESET} service"
msgstr "${BOLDYELLOW}Menghentikan${COLOR_RESET} layanan ${BOLDWHITE}${servicename}${COLOR_RESET}"

#: service:69
#, sh-format
msgid ""
"${BOLDCYAN}Restarting${COLOR_RESET} the "
"${BOLDWHITE}${servicename}${COLOR_RESET} service"
msgstr "${BOLDCYAN}Memulai ulang${COLOR_RESET} layanan ${BOLDWHITE}${servicename}${COLOR_RESET}"

#: service:89
#, sh-format
msgid "The $service service"
msgstr "Layanan $service"

#: service:115
#, sh-format
msgid "usage : service start|stop|restart|list [service_name]"
msgstr "penggunaan : service start|stop|restart|list [nama_layanan]"
